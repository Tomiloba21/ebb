#!/usr/bin/env python3
"""Ebb: start, stop and watch your dev projects from one window.

Usage:
  ebb [--project NAME]          open the window (optionally on one project)
  ebb list                      list projects, services and actions
  ebb status [PROJECT]          show service status
  ebb start PROJECT [SERVICE]   start one service, or all of a project's services
  ebb stop PROJECT [SERVICE]    stop one service, or all of a project's services
  ebb run PROJECT ACTION        run an action and wait for it

Projects are defined in ~/.config/ebb/config.toml (or $EBB_CONFIG).
Logs and pid files live in ~/.local/state/ebb/.
"""
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
import tomllib
import urllib.request
from dataclasses import dataclass, field
from pathlib import Path

APP_ID = "io.github.tomiloba21.Ebb"
CONFIG = Path(os.environ.get("EBB_CONFIG") or
              Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "ebb/config.toml")
STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "ebb"

STOPPED, STARTING, RUNNING = "Stopped", "Starting…", "Running"


# --- config ---

class ConfigError(Exception):
    pass


def slug(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "item"


def expand(value):
    return os.path.expandvars(os.path.expanduser(str(value)))


@dataclass
class Service:
    name: str
    start: str
    cwd: Path
    env: dict
    log: Path
    description: str = ""
    icon: str = "system-run-symbolic"
    stop: str | None = None
    http: str | None = None
    port: int | None = None
    process: str | None = None
    ready: str | None = None


@dataclass
class Action:
    name: str
    run: str
    cwd: Path
    env: dict
    log: Path
    description: str = ""
    icon: str = "media-playback-start-symbolic"
    highlight: bool = False


@dataclass
class Project:
    name: str
    cwd: Path
    description: str = ""
    services: list = field(default_factory=list)
    actions: list = field(default_factory=list)

    def service(self, name):
        return find(self.services, name, f"service in {self.name}")

    def action(self, name):
        return find(self.actions, name, f"action in {self.name}")


def find(items, name, what):
    for item in items:
        if item.name.lower() == name.lower() or slug(item.name) == slug(name):
            return item
    raise ConfigError(f"No {what} called '{name}'. Try: {', '.join(i.name for i in items) or 'none defined'}")


def read_raw(path=CONFIG):
    """The config file as plain dicts and lists; empty if there is no file yet."""
    if not path.exists():
        return {}
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        raise ConfigError(f"{path}: {e}") from e


def load_config(path=CONFIG):
    return parse(read_raw(path))


BARE_KEY = re.compile(r"^[A-Za-z0-9_-]+$")
KEY_ORDER = ["name", "description", "cwd", "icon", "start", "stop", "run", "http", "port", "ready", "process",
             "highlight", "env"]


def toml_key(key):
    return key if BARE_KEY.match(key) else json.dumps(key, ensure_ascii=False)


def toml_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)  # JSON strings are valid TOML basic strings
    if isinstance(value, dict):
        return "{ " + ", ".join(f"{toml_key(k)} = {toml_value(v)}" for k, v in value.items()) + " }"
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(v) for v in value) + "]"
    raise ConfigError(f"Can't save a value of type {type(value).__name__}")


def toml_lines(table, indent="", skip=()):
    keys = sorted((k for k in table if k not in skip),
                  key=lambda k: KEY_ORDER.index(k) if k in KEY_ORDER else len(KEY_ORDER))
    return [f"{indent}{toml_key(k)} = {toml_value(table[k])}" for k in keys if table[k] not in ("", None, {}, [])]


def to_toml(data):
    out = ["# Ebb config. Edit it in Ebb, or by hand: README.md describes every key.", ""]
    out += toml_lines(data, skip=("env", "project"))
    if data.get("env"):
        out += ["[env]"] + toml_lines(data["env"]) + [""]
    for project in data.get("project", []):
        out += ["", "[[project]]"] + toml_lines(project, skip=("service", "action"))
        for kind in ("service", "action"):
            for item in project.get(kind, []):
                out += ["", f"  [[project.{kind}]]"] + toml_lines(item, "  ")
    return "\n".join(out).strip() + "\n"


def save_raw(data, path=CONFIG):
    """Write the config, keeping the previous file as config.toml.bak. Comments are not preserved."""
    text = to_toml(data)
    parse(tomllib.loads(text))  # never write a file Ebb can't read back
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        shutil.copy2(path, path.with_name(path.name + ".bak"))
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def parse(data):
    def env_of(table):
        return {k: expand(v) for k, v in table.get("env", {}).items()}

    def required(table, key, where):
        if not table.get(key):
            raise ConfigError(f"{where} is missing '{key}'")
        return table[key]

    global_env = env_of(data)
    projects = []
    for p in data.get("project", []):
        pname = required(p, "name", "A [[project]]")
        if any(slug(other.name) == slug(pname) for other in projects):
            raise ConfigError(f"Two projects are called '{pname}'")
        pcwd = Path(expand(p.get("cwd", "~")))
        penv = {**global_env, **env_of(p)}
        project = Project(pname, pcwd, p.get("description", ""))
        state = STATE / slug(pname)

        for s in p.get("service", []):
            sname = required(s, "name", f"A service in '{pname}'")
            port = s.get("port")
            project.services.append(Service(
                name=sname,
                start=required(s, "start", f"Service '{sname}' in '{pname}'"),
                cwd=pcwd / expand(s.get("cwd", ".")),
                env={**penv, **env_of(s)},
                log=state / f"{slug(sname)}.log",
                description=s.get("description", ""),
                icon=s.get("icon", "system-run-symbolic"),
                stop=s.get("stop"),
                http=s.get("http"),
                port=int(port) if port else None,
                process=s.get("process"),
                ready=s.get("ready"),
            ))
        for a in p.get("action", []):
            aname = required(a, "name", f"An action in '{pname}'")
            project.actions.append(Action(
                name=aname,
                run=required(a, "run", f"Action '{aname}' in '{pname}'"),
                cwd=pcwd / expand(a.get("cwd", ".")),
                env={**penv, **env_of(a)},
                log=state / f"action-{slug(aname)}.log",
                description=a.get("description", ""),
                icon=a.get("icon", "media-playback-start-symbolic"),
                highlight=bool(a.get("highlight", False)),
            ))
        projects.append(project)
    return projects


# --- processes ---

CHILDREN = {}  # pid -> Popen, so the window can reap services that exit while it is open


def shell(cmd, login=True):
    return ["bash", "-lc" if login else "-c", cmd]


def environ(item):
    return {**os.environ, **item.env}


def check_cwd(item):
    if not item.cwd.is_dir():
        raise ConfigError(f"{item.name}: folder {item.cwd} does not exist")


def pidfile(svc):
    return svc.log.with_suffix(".pid")


def group_alive(pid):
    if pid in CHILDREN and CHILDREN[pid].poll() is not None:
        del CHILDREN[pid]
    try:
        os.killpg(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def our_pid(svc):
    try:
        pid = int(pidfile(svc).read_text())
    except (OSError, ValueError):
        return None
    return pid if group_alive(pid) else None


def port_open(port):
    for host in ("127.0.0.1", "::1"):
        try:
            with socket.create_connection((host, port), timeout=0.5):
                return True
        except OSError:
            pass
    return False


def port_pids(port):
    out = subprocess.run(["ss", "-ltnpH", f"sport = :{port}"], capture_output=True, text=True).stdout
    return sorted({int(p) for p in re.findall(r"pid=(\d+)", out)})


def http_ok(url):
    try:
        with urllib.request.urlopen(url, timeout=1.5) as r:
            return 200 <= r.status < 400
    except Exception:
        return False


def command_ok(cmd, item):
    try:
        return subprocess.run(shell(cmd, login=False), cwd=item.cwd if item.cwd.is_dir() else None,
                              env=environ(item), capture_output=True, timeout=5).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def process_found(pattern):
    return subprocess.run(["pgrep", "-f", pattern], capture_output=True).returncode == 0


def status(svc):
    """Running when the service's ready checks pass; Starting while its process exists but isn't ready yet."""
    checks = [c for c in (svc.http and (lambda: http_ok(svc.http)),
                          svc.port and not svc.http and (lambda: port_open(svc.port)),
                          svc.ready and (lambda: command_ok(svc.ready, svc))) if c]
    alive = bool(our_pid(svc)) or bool(svc.process and process_found(svc.process))
    if checks:
        if all(check() for check in checks):
            return RUNNING
        if alive or (svc.port and port_open(svc.port)):
            return STARTING
        return STOPPED
    return RUNNING if alive else STOPPED


def start(svc):
    if status(svc) != STOPPED:
        return
    check_cwd(svc)
    svc.log.parent.mkdir(parents=True, exist_ok=True)
    with open(svc.log, "w") as log:
        p = subprocess.Popen(shell(svc.start), cwd=svc.cwd, env=environ(svc), stdout=log,
                             stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    CHILDREN[p.pid] = p
    pidfile(svc).write_text(str(p.pid))


def wait_gone(pid, seconds):
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        if not group_alive(pid):
            return True
        time.sleep(0.25)
    return False


def stop(svc):
    if svc.stop:
        try:
            subprocess.run(shell(svc.stop), cwd=svc.cwd if svc.cwd.is_dir() else None, env=environ(svc),
                           capture_output=True, timeout=60)
        except subprocess.TimeoutExpired:
            pass
    pid = our_pid(svc)
    if pid and not (svc.stop and wait_gone(pid, 10)):
        # SIGINT first, like Ctrl-C in a terminal, so tools such as Gradle shut down cleanly.
        for sig, grace in ((signal.SIGINT, 10), (signal.SIGTERM, 5), (signal.SIGKILL, 1)):
            try:
                os.killpg(pid, sig)
            except ProcessLookupError:
                break
            if wait_gone(pid, grace):
                break
    if svc.process and not svc.stop:
        subprocess.run(["pkill", "-f", svc.process], capture_output=True)
    if svc.port:  # whatever still listens, e.g. a server started outside Ebb
        for p in port_pids(svc.port):
            try:
                os.kill(p, signal.SIGTERM)
            except ProcessLookupError:
                pass
    pidfile(svc).unlink(missing_ok=True)


def run_action(action):
    """Run an action to completion; returns its exit code."""
    check_cwd(action)
    action.log.parent.mkdir(parents=True, exist_ok=True)
    with open(action.log, "w") as log:
        return subprocess.run(shell(action.run), cwd=action.cwd, env=environ(action), stdout=log,
                              stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL).returncode


# --- command line ---

def cli(args):
    projects = load_config()
    if not projects:
        raise ConfigError(f"No projects yet. Open Ebb to add one, or edit {CONFIG}")
    cmd, rest = args[0], args[1:]
    if cmd == "list":
        for p in projects:
            print(p.name)
            for s in p.services:
                print(f"  service  {s.name}")
            for a in p.actions:
                print(f"  action   {a.name}")
        return 0
    if cmd == "status":
        for p in ([find(projects, rest[0], "project")] if rest else projects):
            print(p.name)
            for s in p.services:
                print(f"  {s.name:<24} {status(s)}")
        return 0
    if cmd in ("start", "stop") and rest:
        project = find(projects, rest[0], "project")
        services = [project.service(rest[1])] if len(rest) > 1 else project.services
        for s in services:
            (start if cmd == "start" else stop)(s)
            print(f"{cmd}: {s.name}")
        return 0
    if cmd == "run" and len(rest) == 2:
        action = find(projects, rest[0], "project").action(rest[1])
        code = run_action(action)
        print(f"{action.name}: {'done' if code == 0 else f'failed (exit {code}), see {action.log}'}")
        return code
    print(__doc__, file=sys.stderr)
    return 2


if len(sys.argv) > 1 and not sys.argv[1].startswith("-"):
    try:
        sys.exit(cli(sys.argv[1:]))
    except ConfigError as e:
        sys.exit(f"ebb: {e}")
if any(a in ("-h", "--help") for a in sys.argv[1:]):
    sys.exit(print(__doc__))


