class ServiceRow(Adw.ActionRow):
    def __init__(self, win, svc, edit):
        super().__init__(use_markup=False, subtitle_lines=1)
        self.set_title(svc.name)
        self.set_subtitle(svc.description or svc.start)
        self.win, self.svc, self.busy = win, svc, False
        self.add_prefix(icon(svc.icon))
        self.state = Gtk.Label(css_classes=["dim-label", "caption"])
        self.spinner = Adw.Spinner(visible=False)
        self.start_btn = icon_button("media-playback-start-symbolic", "Start", lambda: self.act(start, "Starting…"))
        self.stop_btn = icon_button("media-playback-stop-symbolic", "Stop", lambda: self.act(stop, "Stopping…"))
        for w in (self.spinner, self.state, self.start_btn, self.stop_btn,
                  icon_button("document-open-symbolic", "Open log", lambda: open_file(svc.log)),
                  icon_button("document-edit-symbolic", "Edit", edit)):
            self.add_suffix(w)

    def act(self, fn, text):
        self.set_busy(text)
        in_background(lambda: fn(self.svc), self.finished)

    def finished(self, _, error):
        self.busy = False
        if error:
            self.win.toast(f"{self.svc.name}: {error}")
        self.win.refresh()

    def set_busy(self, text):
        self.busy = True
        self.show(text)

    def show(self, text):
        self.spinner.set_visible(text.endswith("…"))
        self.state.set_label(text)
        self.state.set_css_classes(["caption", "success" if text == RUNNING else "dim-label"])
        self.start_btn.set_visible(text == STOPPED)
        self.stop_btn.set_visible(text != STOPPED and not self.busy)

    def update(self, state):
        if not self.busy:
            self.show(state)


class ActionRow(Adw.ActionRow):
    def __init__(self, win, action, edit):
        super().__init__(use_markup=False, subtitle_lines=1)
        self.set_title(action.name)
        self.set_subtitle(action.description or action.run)
        self.win, self.action = win, action
        self.add_prefix(icon(action.icon))
        self.spinner = Adw.Spinner(visible=False)
        self.run_btn = Gtk.Button(label="Run", valign=Gtk.Align.CENTER,
                                  css_classes=["suggested-action"] if action.highlight else [])
        self.run_btn.connect("clicked", lambda *_: self.run())
        for w in (self.spinner, self.run_btn,
                  icon_button("document-open-symbolic", "Open log", lambda: open_file(action.log)),
                  icon_button("document-edit-symbolic", "Edit", edit)):
            self.add_suffix(w)

    def run(self):
        self.run_btn.set_sensitive(False)
        self.spinner.set_visible(True)
        in_background(lambda: run_action(self.action), self.finished)

    def finished(self, code, error):
        self.run_btn.set_sensitive(True)
        self.spinner.set_visible(False)
        if error:
            self.win.toast(f"{self.action.name}: {error}")
        elif code == 0:
            self.win.toast(f"{self.action.name}: done")
        else:
            self.win.toast(f"{self.action.name} failed (exit {code})", self.action.log)


def add_row(title, handler):
    row = Adw.ButtonRow(title=title, start_icon_name="list-add-symbolic")
    row.connect("activated", lambda *_: handler())
    return row


def project_page(win, project, pindex):
    def editor(*args):
        return lambda: win.open_editor(*args)

    page = Adw.PreferencesPage()
    header = Adw.PreferencesGroup()
    box = Gtk.Box(spacing=12)
    text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
    text.append(Gtk.Label(label=project.name, xalign=0, wrap=True, css_classes=["title-2"]))
    if project.description:
        text.append(Gtk.Label(label=project.description, xalign=0, wrap=True, css_classes=["dim-label"]))
    text.append(Gtk.Label(label=home_short(project.cwd), xalign=0, css_classes=["caption", "dim-label", "monospace"]))
    box.append(text)
    edit = Gtk.Button(child=Adw.ButtonContent(icon_name="document-edit-symbolic", label="Edit project"),
                      valign=Gtk.Align.CENTER, css_classes=["flat"])
    edit.connect("clicked", lambda *_: win.open_editor(ProjectEditor, pindex))
    box.append(edit)
    header.add(box)
    page.add(header)

    rows = []
    services = Adw.PreferencesGroup(title="Services")
    if project.services:
        buttons = Gtk.Box(spacing=6)
        for label, fn in (("Start all", start), ("Stop all", stop)):
            b = Gtk.Button(label=label, css_classes=["flat"])
            b.connect("clicked", lambda _, fn=fn: win.all(rows, fn))
            buttons.append(b)
        services.set_header_suffix(buttons)
    for i, svc in enumerate(project.services):
        row = ServiceRow(win, svc, editor(ItemEditor, pindex, "service", i))
        rows.append(row)
        services.add(row)
    services.add(add_row("Add service", editor(ItemEditor, pindex, "service")))
    page.add(services)

    actions = Adw.PreferencesGroup(title="Actions")
    for i, action in enumerate(project.actions):
        actions.add(ActionRow(win, action, editor(ItemEditor, pindex, "action", i)))
    actions.add(add_row("Add action", editor(ItemEditor, pindex, "action")))
    page.add(actions)
    return page, rows


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Ebb", default_width=920, default_height=640)
        self.rows, self.refreshing, self.data, self.stack, self.told_backup = [], False, None, None, False

        self.actions = {}
        for name, fn in (("add-project", lambda: self.open_editor(ProjectEditor)),
                         ("global-env", lambda: self.open_editor(GlobalEnvEditor)),
                         ("reload", self.load),
                         ("open-config", lambda: open_file(CONFIG)),
                         ("about", self.about)):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda *_, fn=fn: fn())
            self.add_action(action)
            self.actions[name] = action

        header = Adw.HeaderBar()
        add = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="Add project", action_name="win.add-project")
        header.pack_start(add)
        menu = Gio.Menu()
        menu.append("Environment for all projects", "win.global-env")
        section = Gio.Menu()
        section.append("Reload config", "win.reload")
        section.append("Open config file", "win.open-config")
        menu.append_section(None, section)
        about = Gio.Menu()
        about.append("About Ebb", "win.about")
        menu.append_section(None, about)
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu, primary=True,
                                       tooltip_text="Menu"))

        self.toasts = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.set_content(self.toasts)
        self.set_content(view)

        self.load()
        GLib.timeout_add_seconds(3, self.refresh)

    def load(self, select=None):
        if select is None and self.stack:
            select = self.stack.get_visible_child_name()
        self.rows, self.stack = [], None
        try:
            self.data = read_raw()
            projects = parse(self.data)
        except ConfigError as e:
            self.data = None
            self.show_body(self.message("The config file has a problem", str(e), "dialog-warning-symbolic",
                                        [("Open config file", "win.open-config"), ("Try again", "win.reload")]))
            return
        if not projects:
            self.show_body(self.message("No projects yet",
                                        "Add a project, then its services and actions, to start and stop "
                                        "them from here.", APP_ID, [("Add project", "win.add-project")]))
            return

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, hexpand=True)
        for pindex, project in enumerate(projects):
            page, rows = project_page(self, project, pindex)
            self.rows += rows
            self.stack.add_titled(page, slug(project.name), project.name)
        sidebar = Gtk.StackSidebar(stack=self.stack, width_request=200)
        box = Gtk.Box()
        box.append(sidebar)
        box.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        box.append(self.stack)
        self.show_body(box)
        if select:
            self.select(select)
        self.refresh()

    def show_body(self, widget):
        self.toasts.set_child(widget)
        for name in ("add-project", "global-env"):
            self.actions[name].set_enabled(self.data is not None)

    def message(self, title, text, icon_name, buttons):
        page = Adw.StatusPage(title=title, description=GLib.markup_escape_text(text), icon_name=icon_name)
        box = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
        for i, (label, action) in enumerate(buttons):
            box.append(Gtk.Button(label=label, action_name=action,
                                  css_classes=["pill"] + (["suggested-action"] if i == 0 else [])))
        page.set_child(box)
        return page

    def select(self, name):
        if self.stack and self.stack.get_child_by_name(slug(name)):
            self.stack.set_visible_child_name(slug(name))

    def open_editor(self, cls, *args):
        if self.data is not None:
            cls(self, *args).present(self)

    def change(self, mutate, select=None):
        """Apply mutate() to a copy of the config, save it and rebuild the window. Returns True on success."""
        data = copy.deepcopy(self.data)
        mutate(data)
        try:
            save_raw(data)
        except (ConfigError, OSError) as e:
            self.toast(f"Couldn't save: {e}")
            return False
        self.load(select)
        if not self.told_backup:
            self.toast(f"Saved. The previous version is kept as {CONFIG.name}.bak")
            self.told_backup = True
        return True

    def toast(self, text, log=None):
        t = Adw.Toast(title=GLib.markup_escape_text(text), timeout=5)
        if log:
            t.set_button_label("Log")
            t.connect("button-clicked", lambda *_: open_file(log))
        self.toasts.add_toast(t)

    def about(self):
        Adw.AboutDialog(application_name="Ebb", application_icon=APP_ID, version=VERSION, developer_name="Tomiloba",
                        comments="Start, stop and watch your dev projects.", license_type=Gtk.License.MIT_X11,
                        website="https://github.com/Tomiloba21/ebb").present(self)

    def all(self, rows, fn):
        for row in rows:
            row.set_busy("Starting…" if fn is start else "Stopping…")
        in_background(lambda: [fn(r.svc) for r in rows], lambda _, e: self.all_done(rows, e))

    def all_done(self, rows, error):
        for row in rows:
            row.busy = False
        if error:
            self.toast(str(error))
        self.refresh()

    def refresh(self):
        if self.refreshing or not self.rows:
            return True
        self.refreshing = True
        rows = list(self.rows)

        def done(states, _):
            self.refreshing = False
            for row, state in zip(rows, states or []):
                row.update(state)
        in_background(lambda: [status(r.svc) for r in rows], done)
        return True


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.add_main_option("project", ord("p"), GLib.OptionFlags.NONE, GLib.OptionArg.STRING,
                             "Open on this project", "NAME")

    def do_startup(self):
        Adw.Application.do_startup(self)
        self.set_accels_for_action("win.reload", ["<Control>r"])
        self.set_accels_for_action("win.add-project", ["<Control>n"])

    def do_command_line(self, command_line):
        win = self.props.active_window or Window(self)
        project = command_line.get_options_dict().lookup_value("project")
        if project:
            win.select(project.get_string())
        win.present()
        return 0


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
