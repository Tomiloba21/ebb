def in_background(work, done=None):
    """Run work() off the UI thread, then done(result, error) on it."""
    def go():
        try:
            result, error = work(), None
        except Exception as e:  # shown to the user as a toast
            result, error = None, e
        if done:
            GLib.idle_add(lambda: done(result, error) and False)
    threading.Thread(target=go, daemon=True).start()


def home_short(path):
    p, home = str(path), str(Path.home())
    return "~" + p[len(home):] if p == home or p.startswith(home + "/") else p


def put(table, key, value):
    """Set a config key, or drop it when empty so the file stays tidy."""
    if value in ("", None, {}, False):
        table.pop(key, None)
    else:
        table[key] = value


def icon(name, size=24):
    path = Path(expand(name))
    image = Gtk.Image.new_from_file(str(path)) if path.is_file() else Gtk.Image.new_from_icon_name(name)
    image.set_pixel_size(size)
    return image


def icon_button(icon_name, tooltip, handler, *css):
    b = Gtk.Button(icon_name=icon_name, tooltip_text=tooltip, valign=Gtk.Align.CENTER,
                   css_classes=["flat", *css])
    b.connect("clicked", lambda *_: handler())
    return b


def open_file(path):
    if path.exists():
        Gio.AppInfo.launch_default_for_uri(path.as_uri(), None)


# --- editor widgets ---

class FolderRow(Adw.ActionRow):
    """A folder picker. With a base folder, folders inside it are stored relative to it."""

    def __init__(self, title, value, base, empty_text):
        super().__init__(title=title)
        self.base, self.empty_text = base, empty_text
        pick = icon_button("folder-open-symbolic", "Choose folder", self.choose)
        self.clear = icon_button("edit-clear-symbolic", "Reset", lambda: self.set(""))
        self.add_suffix(self.clear)
        self.add_suffix(pick)
        self.set_activatable_widget(pick)
        self.set(value or "")

    def set(self, value):
        self.value = value
        self.set_subtitle(value or self.empty_text)
        self.clear.set_visible(bool(value))

    def resolved(self):
        if self.base is None:
            return Path(expand(self.value or "~"))
        return Path(expand(self.base)) / expand(self.value or ".")

    def choose(self):
        dialog = Gtk.FileDialog(title=f"Choose {self.get_title().lower()}")
        if self.resolved().is_dir():
            dialog.set_initial_folder(Gio.File.new_for_path(str(self.resolved())))
        dialog.select_folder(self.get_root(), None, self.chosen)

    def chosen(self, dialog, result):
        try:
            path = Path(dialog.select_folder_finish(result).get_path())
        except GLib.Error:
            return  # cancelled
        if self.base is not None:
            try:
                relative = path.relative_to(Path(expand(self.base)))
                self.set("" if str(relative) == "." else str(relative))
                return
            except ValueError:
                pass
        self.set(home_short(path))


class IconRow(Adw.ComboRow):
    def __init__(self, value, default):
        super().__init__(title="Icon")
        value = value or default
        self.choices = list(ICONS)
        if value not in [name for _, name in self.choices]:
            self.choices.insert(0, ("Custom", value))
        self.set_model(Gtk.StringList.new([name for _, name in self.choices]))
        factory = Gtk.SignalListItemFactory()
        factory.connect("setup", self.setup_item)
        factory.connect("bind", self.bind_item)
        self.set_factory(factory)
        self.set_selected([name for _, name in self.choices].index(value))

    def setup_item(self, _, item):
        box = Gtk.Box(spacing=10)
        box.append(Gtk.Image())
        box.append(Gtk.Label(xalign=0))
        item.set_child(box)

    def bind_item(self, _, item):
        name = item.get_item().get_string()
        box = item.get_child()
        image = box.get_first_child()
        if Path(expand(name)).is_file():
            image.set_from_file(expand(name))
        else:
            image.set_from_icon_name(name)
        box.get_last_child().set_label(next(label for label, n in self.choices if n == name))

    @property
    def value(self):
        return self.choices[self.get_selected()][1]


class EnvGroup(Adw.PreferencesGroup):
    """Environment variables as editable rows, plus a row to add one."""

    def __init__(self, env, description):
        super().__init__(title="Environment variables", description=description)
        self.rows = []
        self.adder = Adw.EntryRow(title="Add a variable: type its name and press Enter", show_apply_button=True)
        self.adder.connect("apply", lambda *_: self.on_add())
        self.adder.connect("changed", lambda *_: self.adder.remove_css_class("error"))
        self.add(self.adder)
        for key, value in (env or {}).items():
            self.add_var(key, str(value))

    def add_var(self, key, value=""):
        row = Adw.EntryRow(title=key, text=value)
        row.add_suffix(icon_button("user-trash-symbolic", f"Remove {key}", lambda: self.remove_var(row)))
        self.remove(self.adder)
        self.add(row)
        self.add(self.adder)
        self.rows.append(row)
        return row

    def remove_var(self, row):
        self.rows.remove(row)
        self.remove(row)

    def on_add(self):
        key = self.adder.get_text().strip()
        if not ENV_NAME.match(key) or key in (r.get_title() for r in self.rows):
            self.adder.add_css_class("error")
            return
        self.adder.set_text("")
        self.add_var(key).grab_focus()

    @property
    def value(self):
        return {r.get_title(): r.get_text() for r in self.rows}


class Editor(Adw.Dialog):
    """A form with Cancel/Save in its header. Subclasses add groups and implement save()."""

    def __init__(self, win, title):
        super().__init__(title=title, content_width=620, content_height=720)
        self.win, self.checks = win, []
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.close())
        self.save_button = Gtk.Button(label="Save", css_classes=["suggested-action"])
        self.save_button.connect("clicked", lambda *_: self.save() and self.close())
        header = Adw.HeaderBar(show_start_title_buttons=False, show_end_title_buttons=False)
        header.pack_start(cancel)
        header.pack_end(self.save_button)
        self.page = Adw.PreferencesPage()
        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.set_content(self.page)
        self.set_child(view)

    def group(self, title=None, description=None):
        group = Adw.PreferencesGroup(title=title or "",
                                     description=description and GLib.markup_escape_text(description))
        self.page.add(group)
        return group

    def entry(self, group, title, text="", valid=None, digits=False):
        """An entry row; valid(text) -> bool makes it required/checked (shown red only once typed in)."""
        row = Adw.EntryRow(title=title, text="" if text is None else str(text))
        if digits:
            row.set_input_purpose(Gtk.InputPurpose.DIGITS)
        if valid:
            self.checks.append((row, valid))
            row.connect("changed", lambda *_: self.validate())
        group.add(row)
        return row

    def validate(self):
        ok = True
        for row, valid in self.checks:
            good = valid(row.get_text().strip())
            ok = ok and good
            if good or not row.get_text():
                row.remove_css_class("error")
            else:
                row.add_css_class("error")
        self.save_button.set_sensitive(ok)

    def delete_button(self, label, heading, body, delete):
        button = Adw.ButtonRow(title=label, css_classes=["destructive-action"])
        button.connect("activated", lambda *_: self.confirm(heading, body, delete))
        self.group().add(button)

    def confirm(self, heading, body, delete):
        alert = Adw.AlertDialog(heading=heading, body=body)
        alert.add_response("cancel", "Cancel")
        alert.add_response("delete", "Delete")
        alert.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        alert.set_default_response("cancel")
        alert.set_close_response("cancel")
        alert.connect("response", lambda _, r: r == "delete" and delete() and self.close())
        alert.present(self)

    def save(self):
        raise NotImplementedError


def unique(names, current=None):
    """valid() for a name that must be set and differ from the others (ignoring case and punctuation)."""
    taken = {slug(n) for n in names if n != current}
    return lambda text: bool(text) and slug(text) not in taken


class ProjectEditor(Editor):
    def __init__(self, win, index=None):
        super().__init__(win, "Edit project" if index is not None else "New project")
        self.index = index
        raw = win.data["project"][index] if index is not None else {}
        names = [p.get("name", "") for p in win.data.get("project", [])]

        g = self.group()
        self.name = self.entry(g, "Name", raw.get("name"), unique(names, raw.get("name")))
        self.description = self.entry(g, "Description", raw.get("description"))
        self.folder = FolderRow("Folder", raw.get("cwd", ""), None, "Home folder")
        self.folder.set_tooltip_text("Commands run here unless a service or action picks another folder")
        g.add(self.folder)

        self.env = EnvGroup(raw.get("env"), "For every service and action in this project. "
                                            "~ and $VARIABLES are expanded.")
        self.page.add(self.env)
        if index is not None:
            self.delete_button("Delete project", f"Delete {raw.get('name')}?",
                               "Its services and actions are removed from Ebb. Running services keep running, "
                               "and no files are deleted.", self.delete)
        self.validate()

    def save(self):
        name = self.name.get_text().strip()

        def change(data):
            projects = data.setdefault("project", [])
            project = projects[self.index] if self.index is not None else {}
            put(project, "name", name)
            put(project, "description", self.description.get_text().strip())
            put(project, "cwd", self.folder.value)
            put(project, "env", self.env.value)
            if self.index is None:
                projects.append(project)
        return self.win.change(change, select=name)

    def delete(self):
        return self.win.change(lambda data: data["project"].pop(self.index))


class ItemEditor(Editor):
    """Edits one [[project.service]] (kind "service") or [[project.action]] (kind "action")."""

    def __init__(self, win, pindex, kind, index=None):
        super().__init__(win, f"{'Edit' if index is not None else 'New'} {kind}")
        self.pindex, self.kind, self.index = pindex, kind, index
        project = win.data["project"][pindex]
        items = project.get(kind, [])
        raw = items[index] if index is not None else {}
        service = kind == "service"

        g = self.group()
        self.name = self.entry(g, "Name", raw.get("name"), unique([i.get("name", "") for i in items], raw.get("name")))
        self.description = self.entry(g, "Description", raw.get("description"))
        self.icon = IconRow(raw.get("icon"), "system-run-symbolic" if service else "media-playback-start-symbolic")
        g.add(self.icon)

        g = self.group("Command", "Runs in bash, so &&, pipes, ~ and $VARIABLES work."
                       + (" The start command should keep running until it's stopped." if service else ""))
        self.folder = FolderRow("Folder", raw.get("cwd", ""), project.get("cwd", "~"), "Project folder")
        g.add(self.folder)
        if service:
            self.command = self.entry(g, "Start command", raw.get("start"), bool)
            self.stop = self.entry(g, "Stop command (optional: default is Ctrl-C)", raw.get("stop"))
            g = self.group("Status checks", "Ebb shows Running when every check you fill in passes, and "
                           "Starting… while it waits. Leave them empty to just watch the process Ebb started.")
            self.http = self.entry(g, "URL that answers when it's up", raw.get("http"))
            self.port = self.entry(g, "Port it listens on (also freed on Stop)", raw.get("port"),
                                   lambda t: not t or (t.isdigit() and 0 < int(t) < 65536), digits=True)
            self.ready = self.entry(g, "Command that succeeds when it's ready", raw.get("ready"))
            self.process = self.entry(g, "Process pattern for pgrep -f (finds it even if started elsewhere)",
                                      raw.get("process"))
        else:
            self.command = self.entry(g, "Command", raw.get("run"), bool)
            self.highlight = Adw.SwitchRow(title="Highlight the Run button",
                                           subtitle="Makes it stand out, for the action you use most",
                                           active=bool(raw.get("highlight")))
            g.add(self.highlight)

        self.env = EnvGroup(raw.get("env"), f"Only for this {kind}. ~ and $VARIABLES are expanded.")
        self.page.add(self.env)
        if index is not None:
            self.delete_button(f"Delete {kind}", f"Delete {raw.get('name')}?",
                               f"It's removed from Ebb. {'A running service keeps running. ' if service else ''}"
                               "No files are deleted.", self.delete)
        self.validate()

    def save(self):
        def text(row):
            return row.get_text().strip()

        def change(data):
            items = data["project"][self.pindex].setdefault(self.kind, [])
            item = items[self.index] if self.index is not None else {}
            put(item, "name", text(self.name))
            put(item, "description", text(self.description))
            put(item, "icon", self.icon.value)
            put(item, "cwd", self.folder.value)
            if self.kind == "service":
                put(item, "start", text(self.command))
                put(item, "stop", text(self.stop))
                put(item, "http", text(self.http))
                put(item, "port", int(text(self.port)) if text(self.port) else None)
                put(item, "ready", text(self.ready))
                put(item, "process", text(self.process))
            else:
                put(item, "run", text(self.command))
                put(item, "highlight", self.highlight.get_active())
            put(item, "env", self.env.value)
            if self.index is None:
                items.append(item)
        return self.win.change(change, select=self.win.data["project"][self.pindex]["name"])

    def delete(self):
        return self.win.change(lambda data: data["project"][self.pindex][self.kind].pop(self.index))


